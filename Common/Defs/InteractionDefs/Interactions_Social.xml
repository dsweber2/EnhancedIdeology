<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<InteractionDef>
		<defName>EB_IdeologicalDebateMeme</defName>
		<label>ideological debate over memes</label>
		<workerClass>EnhancedIdeology.InteractionWorker_IdeologicalDebateMeme</workerClass>
		<symbolSource>InitiatorIdeo</symbolSource>
		<logRulesInitiator>
			<rulesStrings>
				<li>r_logentry->[INITIATOR_nameDef] and [RECIPIENT_nameDef] debated memes.</li>
			</rulesStrings>
		</logRulesInitiator>
	</InteractionDef>

	<InteractionDef>
		<defName>EB_IdeologicalDebatePrecept</defName>
		<label>ideological debate over precepts</label>
		<workerClass>EnhancedIdeology.InteractionWorker_IdeologicalDebatePrecept</workerClass>
		<symbolSource>InitiatorIdeo</symbolSource>
		<logRulesInitiator>
			<rulesStrings>
				<li>r_logentry->[INITIATOR_nameDef] and [RECIPIENT_nameDef] debated beliefs.</li>
			</rulesStrings>
		</logRulesInitiator>
	</InteractionDef>

	<!-- Simple grammar used by vanilla/Interaction Bubbles (no custom symbols). -->
	<!-- PlayLogEntry_DebateInteraction.ToGameStringFromPOV_Worker injects rich text for the social log. -->
	<RulePackDef>
		<defName>EB_Sentence_DebateWon</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->[INITIATOR_nameDef] won the debate.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_InitiatorWon</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->[INITIATOR_nameDef] proved more persuasive.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_RecipientWon</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->[RECIPIENT_nameDef] proved more persuasive.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_DebateDraw</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->Neither changed their view.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

