<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<InteractionDef>
		<defName>EB_IdeologicalDebateMeme</defName>
		<label>ideological debate over memes</label>
		<workerClass>EnhancedIdeology.InteractionWorker_IdeologicalDebateMeme</workerClass>
		<symbolSource>InitiatorIdeo</symbolSource>
		<logRulesInitiator>
			<rulesStrings>
				<li>r_logentry->[INITIATOR_nameDef] debated memes with [RECIPIENT_nameDef] about their ideoligion.</li>
			</rulesStrings>
		</logRulesInitiator>
	</InteractionDef>

	<InteractionDef>
		<defName>EB_IdeologicalDebatePrecept</defName>
		<label>ideological debate over precepts</label>
		<workerClass>EnhancedIdeology.InteractionWorker_IdeologicalDebatePrecept</workerClass>
		<symbolSource>InitiatorIdeo</symbolSource>
		<logRulesInitiator>
			<rulesStrings>
				<li>TOPIC_label->a precept</li>
				<li>r_logentry->[INITIATOR_nameDef] debated [TOPIC_label] with [RECIPIENT_nameDef].</li>
			</rulesStrings>
		</logRulesInitiator>
	</InteractionDef>

	<RulePackDef>
		<defName>EB_Sentence_DebateWon</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->[WINNER_nameDef] proved more persuasive.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_InitiatorWon</defName>
		<rulePack>
			<rulesStrings>
				<li>WINNING_STANCE_label->the issue</li>
				<li>sent->[INITIATOR_nameDef] moved [RECIPIENT_nameDef] towards stance "[WINNING_STANCE_label]".</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_RecipientWon</defName>
		<rulePack>
			<rulesStrings>
				<li>WINNING_STANCE_label->the issue</li>
				<li>sent->[RECIPIENT_nameDef] moved [INITIATOR_nameDef] towards stance "[WINNING_STANCE_label]".</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<RulePackDef>
		<defName>EB_Sentence_DebateDraw</defName>
		<rulePack>
			<rulesStrings>
				<li>sent->Neither changed their view.</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

