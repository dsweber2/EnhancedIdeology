<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <MentalStateDef ParentName="BaseMentalState">
        <defName>EB_CrisisOfFaith</defName>
        <stateClass>MentalState_WanderSad</stateClass>
        <label>crisis of faith</label>
        <category>Misc</category>
        <colonistsOnly>true</colonistsOnly>
        <minTicksBeforeRecovery>80000</minTicksBeforeRecovery>
        <maxTicksBeforeRecovery>120000</maxTicksBeforeRecovery>
        <recoveryMtbDays>0.25</recoveryMtbDays>
        <recoverFromSleep>false</recoverFromSleep>
        <moodRecoveryThought>Catharsis</moodRecoveryThought>
        <blockNormalThoughts>true</blockNormalThoughts>
        <nameColor>(0.65, 0.9, 0.93)</nameColor>
        <beginLetterLabel>crisis of faith</beginLetterLabel>
        <beginLetter>{0} is having a crisis of faith.\n\n[PAWN_pronoun] is wandering and questioning [PAWN_possessive] beliefs.</beginLetter>
        <beginLetterDef>NegativeEvent</beginLetterDef>
        <recoveryMessage>{0}'s crisis of faith has passed.</recoveryMessage>
        <baseInspectLine>Mental state: Crisis of faith</baseInspectLine>
        <allowBeatfire>true</allowBeatfire>
        <inCaravanCanDo>true</inCaravanCanDo>
        <escapingPrisonersIgnore>true</escapingPrisonersIgnore>
    </MentalStateDef>

    <MentalBreakDef>
        <defName>EB_Iconoclast</defName>
        <mentalState>EB_Iconoclast</mentalState>
        <baseCommonality>0.333</baseCommonality>
        <intensity>Major</intensity>
    </MentalBreakDef>

    <MentalStateDef ParentName="Tantrum">
        <defName>EB_Iconoclast</defName>
        <stateClass>EnhancedIdeology.MentalState_Iconoclast</stateClass>
        <workerClass>EnhancedIdeology.MentalStateWorker_Iconoclast</workerClass>
        <label>iconoclast</label>
        <minTicksBeforeRecovery>40000</minTicksBeforeRecovery>
        <maxTicksBeforeRecovery>60000</maxTicksBeforeRecovery>
        <recoveryMtbDays>0.166</recoveryMtbDays>
        <beginLetter>{0} had a mental break and is being an iconoclast.\n\n[PAWN_pronoun] is going try and burn religious books.</beginLetter>
        <recoveryMessage>{0} is no longer being an iconoclast.</recoveryMessage>
        <baseInspectLine>Mental state: Iconoclast</baseInspectLine>
        <allowBeatfire>false</allowBeatfire>
    </MentalStateDef>

</Defs>
